local Cat={} local c3,sp=Color3.fromRGB,string.split
local function hx(s) return c3(tonumber(s:sub(1,1),16)*17,tonumber(s:sub(2,2),16)*17,tonumber(s:sub(3,3),16)*17) end
local function parse(str,fn) local t={} for _,ln in ipairs(sp(str,";")) do table.insert(t,fn(sp(ln,"|"))) end return t end
Cat.RARITY_LIST=parse("Common|164|172|182|46;Uncommon|62|196|114|26;Rare|58|154|248|14;Epic|172|84|245|8;Legendary|248|174|34|4;Mythic|242|68|128|1.6;Secret|255|224|72|0.4",function(p) return {id=p[1],color=c3(tonumber(p[2]),tonumber(p[3]),tonumber(p[4])),weight=tonumber(p[5])} end)
