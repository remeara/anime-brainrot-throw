8ef|quad|horn;grandstationo|GrandStationo Elephantino|L|26e5|25500|9ab|fc3|chubby|crown;turbosteam|TurboSteam Dragonini|L|36e5|31500|d33|fc3|tall|pipe;diamondtracko|DiamondTracko Unicorno|L|49e5|38500|eff|7ef|tall|horn;baronvon|BaronVon Brainrotini|L|68e5|46500|713|fc3|chubby|glasses;hyperloopo|HyperLoopo Axolotlini|M|11e6|62e3|f8b|4ef|long|halo;maglevmecha|MaglevMecha Capybaroni|M|16e6|78e3|abc|3eb|chubby|lamp;timewarp|TimeWarp Clockodile|M|23e6|96e3|5b7|fd3|long|clock;celestialrail|CelestialRail Kitsunini|M|32e6|118e3|fed|b7f|quad|halo;quantumticket|QuantumTicket Krakeno|M|45e6|144e3|64c|4fd|octo|ticket;starlightexp|StarlightExpress Griffino|M|64e6|175e3|fc6|8bf|bird|crown;godpigeon|GrandCentral Godpigeon|S|95e6|24e4|ffe|fc3|bird|halo;infinitytrack|InfinityTrack Leviathano|S|135e6|31e4|38d|fd4|long|crown;chronoseraph|ChronoLocomotive Serapho|S|19e7|395e3|d34|fd3|tall|halo;omnibrainrotus|OmniConductor Brainrotus|S|26e7|49e4|82b|fd4|chubby|crown;emperorrex|GoldenTicket EmperorRex|S|36e7|62e4|fc2|a23|tall|ticket"
Cat.CHARACTERS=parse(RAW,function(p) return {id=p[1],name=p[2],rarity=RM[p[3]],cost=tonumber(p[4]),income=tonumber(p[5]),bodyColor=hx(p[6]),accentColor=hx(p[7]),shape=p[8],prop=p[9]} end)
Cat.BY_ID={} for _,ch in ipairs(Cat.CHARACTERS) do Cat.BY_ID[ch.id]=ch end
Cat.UPGRADES=parse("sprint|Sprint Boots|600|2.2|+2.5 WalkSpeed/rank;mallet|Brass Mallet|900|2.25|+25% Whack cash;lock|Turnstile Lock|1100|2.25|+6s Gate Lock;magnet|Ticket Magnet|1400|2.3|+12% Pad income;luck|Golden Luck|1800|2.35|+8% Mutation odds",function(p) return {id=p[1],name=p[2],maxLevel=8,baseCost=tonumber(p[3]),growth=tonumber(p[4]),desc=p[5]} end)
Cat.UPGRADES_BY_ID={} for _,u in ipairs(Cat.UPGRADES) do Cat.UPGRADES_BY_ID[u.id]=u end
Cat.QUESTS=parse("q1|Buy a Parade Brainrot|buys|1|1200;q2|Lock Brass Turnstile [L]|locks|1|2000;q3|Collect Pad Cash|collects|3|3500;q4|Whack Pickpocket Thieves|whacks|2|25e3;q5|Steal from Rival Platform|steals|1|35e3;q6|Survive a Runaway Express|trains|1|45e3;q7|Buy 5 Station Upgrades|upgrades|5|6e4;q8|Fill 6 Platform Pedestals|pads|6|85e3;q9|Unlock 12 Stamp Entries|stamps|12|12e4;q10|Steal 3 Rival Brainrots|steals|3|25e4;q11|Whack 6 Station Thieves|whacks|6|4e5;q12|Fill All 12 Pedestals|pads|12|75e4;q13|Survive 3 Runaway Express|trains|3|12e5;q14|Collect Mutated Brainrots|mutated|6|18e5;q15|Reach Rebirth 1|rebirths|1|25e5;q16|Unlock 28 Stamp Entries|stamps|28|45e5;q17|Collect Chrono-Gold Brainrots|chrono|2|8e6;q18|Reach Rebirth 3|rebirths|3|15e6",function(p) return {id=p[1],title=p[2],metric=p[3],target=tonumber(p[4]),reward=tonumber(p[5])} end)
local sf,mr=string.format,math.random
function Cat.FormatMoney(v) v=math.max(0,math.floor(v+.5)) return v>=1e9 and sf("$%.2fB",v/1e9) or v>=1e7 and sf("$%.1fM",v/1e6) or v>=1e6 and sf("$%.2fM",v/1e6) or v>=1e3 and sf("$%.1fK",v/1e3) or sf("$%d",v) end
function Cat.FormatRate(v) return "+"..Cat.FormatMoney(v).."/s" end
function Cat.GetCharacter(id) return Cat.BY_ID[id] or Cat.CHARACTERS[1] end
function Cat.GetMutation(id) return Cat.MUTATIONS[id] or Cat.MUTATION_LIST[1] end
function Cat.GetUpgradeCost(id,lv) local u=Cat.UPGRADES_BY_ID[id] return u and math.floor(u.baseCost*(u.growth^lv)+.5) or 0 end
function Cat.ComputeIncome(cid,mid,rm,mag) return math.floor(Cat.GetCharacter(cid).income*Cat.GetMutation(mid).mult*math.max(1,rm)*(1+mag*.12)+.5) end
local function ld(s) return parse(s,function(p) return {charId=p[1],mutId=p[2],stored=tonumber(p[3]) or 0} end) end
function Cat.GetShowcaseLoadout() return ld("pigeoncini|brass|12400;saxophono|neon|85200;bullettraino|crystal|148e3;orientexp|prism|42e4;goldenclocko|chrono|965e3;turbosteam|neon|312e3;baronvon|brass|285e3;hyperloopo|crystal|64e4;timewarp|prism|115e4;godpigeon|neon|248e4;chronoseraph|crystal|185e4;emperorrex|brass|392e4") end
function Cat.GetRivalLoadout(w) return ld(w=="north" and "orientexp|chrono;saxophono|neon;bullettraino|crystal;turbosteam|brass" or "godpigeon|chrono;timewarp|prism;quantumticket|crystal;diamondtracko|neon") end
function Cat.PickRandomParade(luck,fm)
	local rt,acc,rar=0,0,"Common" for _,r in ipairs(Cat.RARITY_LIST) do rt+=r.weight end
	local roll=mr()*rt for _,r in ipairs(Cat.RARITY_LIST) do acc+=r.weight if roll<=acc then rar=r.id break end end
	local pool={} for _,ch in ipairs(Cat.CHARACTERS) do if ch.rarity==rar then table.insert(pool,ch) end end
	local mp,mt={},0 for i,m in ipairs(Cat.MUTATION_LIST) do if not fm or i>1 then local w=i>1 and m.weight*(1+luck*.14) or m.weight mt+=w table.insert(mp,{m=m,w=w}) end end
	local roll2,ma,cm=mr()*mt,0,mp[1].m for _,e in ipairs(mp) do ma+=e.w if roll2<=ma then cm=e.m break end end
	return pool[mr(1,#pool)],cm
end
return Cat
